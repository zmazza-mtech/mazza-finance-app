# Caddy configuration for the Playwright E2E stack (docker-compose.e2e.yml).
#
# Deliberately not the production Caddyfile. Two things are dropped:
#
#   - TLS. The production site uses mkcert certificates; serving them here would
#     mean every Playwright context needs ignoreHTTPSErrors, which buys nothing
#     the flow is actually testing.
#   - Basic Auth. Its plaintext password exists nowhere in the repository, and
#     baking a second credential into the harness protects nothing — the stack
#     binds to 127.0.0.1 and holds no real data.
#
# Everything else matches production, including the CSP. The suite loading the
# real bundle under the real header is the point: a CSP that blocks the app's
# own API calls should fail this suite, not the deploy.

:80 {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-src 'none'; object-src 'none'; frame-ancestors 'none'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# API reverse proxy
	handle /api/* {
		reverse_proxy backend:3001
	}

	# Readiness for the container healthcheck and the harness. Proxied rather
	# than answered by Caddy, so "up" means the backend is up too.
	handle /health {
		reverse_proxy backend:3001
	}

	# Frontend SPA — all other routes serve index.html
	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
